{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "version",
    "display_name",
    "description",
    "entrypoint",
    "routing",
    "schema"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intents", "keywords"],
      "properties": {
        "intents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "keywords": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_inputs", "output_type"],
      "properties": {
        "required_inputs": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "output_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
